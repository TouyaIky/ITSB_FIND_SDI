# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
SECRET_KEY=ganti-dengan-string-acak-panjang
FLASK_DEBUG=1
# URL dasar aplikasi untuk tautan reset password (tanpa slash di akhir). WAJIB diisi URL deployment saat online,
# mis. https://USERNAME.pythonanywhere.com. Jika kosong saat FLASK_DEBUG=0, email reset tidak dikirim.
APP_BASE_URL=http://127.0.0.1:5000
# Isi 1 saat dipublikasikan dengan HTTPS (mis. PythonAnywhere)
SESSION_COOKIE_SECURE=0

# ---- Akun Satpam utama (dibuat otomatis jika belum ada akun Satpam asli). GANTI sebelum dipakai sungguhan ----
SECURITY_NAME=Satpam ITSB
SECURITY_EMAIL=satpam@itsb.test
SECURITY_PHONE=081200000000
SECURITY_PASSWORD=Satpam12345

# ---- Akun & data demonstrasi untuk pengujian dosen (kredensial demo bersifat publik, tampil di halaman login) ----
# DEMO_ENABLED=0 mematikan pembuatan akun demo. Akun demo selalu bersih (tanpa data contoh).
DEMO_ENABLED=1
DEMO_USER_EMAIL=demo.user@itsb.test
DEMO_USER_PASSWORD=DemoUser2026
DEMO_SECURITY_EMAIL=demo.satpam@itsb.test
DEMO_SECURITY_PASSWORD=DemoSatpam2026

# ---- EmailJS (HANYA untuk Lupa Password; kritik dan saran tidak memakai email) ----
# Diisi di environment deployment / file .env (JANGAN commit .env). Dipanggil dari backend lewat REST API.
# Template EmailJS memakai variabel {{to_email}} dan {{link}}.
# Dashboard EmailJS: Account > Security > aktifkan "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Opsional: Private Key, wajib hanya bila opsi "Use Private Key" di dashboard EmailJS aktif. Rahasia, hanya dipakai di backend.
EMAILJS_PRIVATE_KEY=
